# --- Fix50 Agent configuration ---
# Which AI provider to use for analysis:
#   mock   - deterministic, no API key, no cost (default)
#   openai - any OpenAI-compatible chat-completions endpoint
AI_PROVIDER=mock

# SQLite database file path (created automatically if missing).
DATABASE_PATH=data/fix50.db

# Uvicorn server settings.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- OpenAI-compatible provider (only used when AI_PROVIDER=openai) ---
# API key is read from the environment only; never hardcode it here.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Groq, local vLLM).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
